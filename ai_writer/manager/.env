# ============================================================================
# AI Writer Manager (Frontend) Configuration
# ============================================================================

# API Base URL (used by Axios in src/api/index.js)
# In development with Vite dev server proxy: '/ai_writer/api'
# In production or direct API connection: full URL or relative path
VITE_API_URL=https://aiapi.alt404.com/api

# Vite Dev Server Proxy Target (backend API server)
# e.g., 'https://aiapi.alt404.com' or 'http://localhost:8001'
VITE_PROXY_TARGET=https://aiapi.alt404.com

# Vite Dev Server Port
VITE_PORT=5174
